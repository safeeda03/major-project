# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/poshanai

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# AI Chatbot (server-side only: never place this key in the mobile app)
# Create a key at https://platform.openai.com/api-keys and put its value in backend/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Set to true to let the assistant use web search for current information.
OPENAI_ENABLE_WEB_SEARCH=false
