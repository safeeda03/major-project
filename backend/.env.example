# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/poshanai

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Free local AI chatbot. Install Ollama separately and pull the selected model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Local Malayalam/English speech recognition through faster-whisper.
WHISPER_MODEL=small
# Set this when Python is not available as `python` on PATH.
WHISPER_PYTHON=python

# Handwritten image OCR. With the default settings, the local Tesseract OCR
# remains active. To use Google Cloud Vision, enable the Vision API and point
# this to a service-account JSON file stored outside this repository.
OCR_PROVIDER=auto
GOOGLE_CLOUD_VISION_ENABLED=false
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/poshanai-vision-service-account.json

# Optional Firebase Realtime Database mirror for the latest OCR result.
# This is disabled by default because OCR content can be sensitive health data.
FIREBASE_OCR_SYNC_ENABLED=false
# FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
